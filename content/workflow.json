        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"type\": \"SMS\",\n  \"contactId\": \"{{ $json.contact.id }}\",\n  \"message\": \"Hi {{ $('Normalize Lead').item.json.firstName }}, it's Mia at Radiant Aesthetics — thanks for asking about {{ $('Normalize Lead').item.json.interest }}. I can get you booked this week: https://REPLACE_BOOKING_LINK.example — or just reply here and I'll sort it for you.\"\n}",
        "options": {}
