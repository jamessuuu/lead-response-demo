        "jsonBody": "={\n  \"type\": \"Email\",\n  \"contactId\": \"{{ $('GHL: Upsert Contact').item.json.contact.id }}\",\n  \"subject\": \"Your Radiant Aesthetics enquiry — next step inside\",\n  \"emailFrom\": \"Mia at Radiant Aesthetics <hello@REPLACE_DOMAIN.example>\",\n  \"html\": \"<p>Hi {{ $('Normalize Lead').item.json.firstName }},</p><p>Thanks for reaching out about {{ $('Normalize Lead').item.json.interest }}. I've just texted you as well — whichever is easier.</p><p><a href=\\\"https://REPLACE_BOOKING_LINK.example\\\">Pick a consult time that suits you</a>, or reply to this email and I'll book you in personally.</p><p>— Mia, Radiant Aesthetics</p>\"\n}",
        "options": {}
