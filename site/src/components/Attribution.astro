      <rect x="14.08" y="14.08" width="35.84" height="35.84" fill="none" stroke="currentColor" stroke-width="3.008" />
      <path d="M37.73 20.89 V35.58 a7.88 7.88 0 0 1 -7.88 7.88 H26.27" fill="none" stroke="currentColor" stroke-width="3.968" stroke-linecap="butt" />
      <rect x="17.31" y="17.31" width="4.66" height="4.66" fill="var(--aj-attribution-signal, #B45309)" />
