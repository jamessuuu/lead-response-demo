---
import Base from '../layouts/Base.astro';
import RunPanel from '../components/RunPanel.astro';
import { loadRun } from '../lib/runs.ts';
import { wallClock, offsetLabel } from '@lrd/schema';

// Recording first: Spec section 2 calls the recorded replay "the only
// artefact that proves n8n *ran*" and lists it before the simulator. M1
// makes that real — the recording tab is the default, not an afterthought
// bolted onto the M0 simulator page.
const recordingRun = loadRun('rec-medspa-happy');
const simulatorRun = loadRun('sim-medspa-happy');
const seamRun = loadRun('rec-medspa-slack-401');

const offset = offsetLabel(recordingRun.startedAt);
---

<Base
  title="Demo run — Lead Response Engine"
  description="A real n8n execution, node by node, with the exact timestamps, the exact SMS/email/Slack it composed, and a plain statement of what was real, stubbed, or simulated."
>
  <h1>One lead's run, node by node</h1>
  <p>
    Alex Rivera submitted a website enquiry about lip filler at {wallClock(recordingRun.startedAt)} ({offset}). Below
    is the ordered execution log — real n8n on the <strong>Recording</strong> tab, the same topology run by a
    deterministic engine on the <strong>Simulator</strong> tab. Both read straight from the committed run file;
    nothing here is typed into the page.
  </p>

  <div class="tabs">
    <input type="radio" name="demo-mode" id="tab-recording" class="tabs__input" checked />
    <label for="tab-recording" class="tabs__label">Recording</label>
    <input type="radio" name="demo-mode" id="tab-simulator" class="tabs__input" />
    <label for="tab-simulator" class="tabs__label">Simulator</label>

    <div class="tabs__panel" id="panel-recording">
      <RunPanel run={recordingRun} />
    </div>
    <div class="tabs__panel" id="panel-simulator">
      <RunPanel run={simulatorRun} />
    </div>
  </div>

  <div class="panel" style="margin-top: 2rem;">
    <p class="panel__heading">The recorded seam</p>
    <div class="system-line" style="border-bottom: none;">
      <span class="system-line__text">
        A second real capture (<code>{seamRun.id}</code>) has <code>stubhouse</code> answer Slack's
        <code>chat.postMessage</code> with a real 401, simulating a revoked bot token — n8n's own error path fires
        after the first-touch SMS and email already went out. <a href={`/runs/${seamRun.id}/run.json`}>run.json</a> ·
        <a href={`/runs/${seamRun.id}/execution.json`}>execution.json</a>. Its own execution log doesn't have a page
        yet — the live "break it" buttons that make seams interactive arrive at milestone M2.
      </span>
    </div>
  </div>

  <p>
    This is one of five simulator scenarios <code>packages/engine</code> executes identically and deterministically
    (happy path, a revoked Slack token, a GoHighLevel rate-limit, a duplicate webhook delivery, a reply-check
    timeout — see <code>packages/engine/test/golden/</code>), plus the two real n8n recordings above. Only the happy
    simulator and the two recordings render on this page today; switching live between every scenario and the
    interactive "break it" controls arrive at milestone M2.
  </p>
</Base>
